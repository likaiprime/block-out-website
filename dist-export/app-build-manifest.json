{
  "pages": {
    "/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/layout.js"
    ],
    "/(default)/[lang]/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/(default)/[lang]/layout.css",
      "static/chunks/app/(default)/[lang]/layout.js"
    ],
    "/(default)/[lang]/not-found": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(default)/[lang]/not-found.js"
    ],
    "/(default)/[lang]/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(default)/[lang]/page.js"
    ]
  }
}