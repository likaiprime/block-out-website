{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blockout",
  // A pure static export: no Worker script, Cloudflare serves dist-export as-is.
  // www -> apex is a zone redirect rule, which runs before the Worker.
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist-export",
    // /level/1 -> /level/1/ and /level/1/ -> level/1/index.html, as nginx did.
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "blockout.cc", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
